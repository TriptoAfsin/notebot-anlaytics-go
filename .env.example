DB_URL=test
PORT=3306
AUTH_KEY=test
DB_USER=test
DB_USER_PASS=test
DB_HOST=test
DB_NAME=test
DB_PORT=test
ADMIN_KEY=test
# Optional: the analytics dashboard login password; unlocks the same admin endpoints as ADMIN_KEY
DASHBOARD_PASS=
# DB_DRIVER selects the backend: "postgres" (notebot v2 DB) or "mysql" (legacy, uses DB_* above).
DB_DRIVER=postgres
# For DB_DRIVER=postgres, set the notebot v2 Postgres URL (search_path=analytics auto-added):
DATABASE_URL=postgres://user:pass@host:port/railway
ENVIRONMENT=development
