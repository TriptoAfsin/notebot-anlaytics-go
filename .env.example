DB_URL=test
PORT=3306
AUTH_KEY=test
DB_USER=test
DB_USER_PASS=test
DB_HOST=test
DB_NAME=test
DB_PORT=test
ADMIN_KEY=test
# DB_DRIVER selects the backend: "mysql" (default, legacy) or "postgres" (notebot v2 DB).
DB_DRIVER=mysql
# For DB_DRIVER=postgres, set the notebot v2 Postgres URL (search_path=analytics is auto-added):
#   DATABASE_URL=postgres://user:pass@host:port/railway
DATABASE_URL=test
ENVIRONMENT=development
